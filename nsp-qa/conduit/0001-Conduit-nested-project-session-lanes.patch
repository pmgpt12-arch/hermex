+        guard shownFilter == nil, profileParts.count > 1 else { return merged }
+        var seenPaths = Set(merged.compactMap(hierarchyPath))
+        let originals = profileParts.first?.lanes ?? []
+        let missing = originals.filter { lane in
+            guard let path = hierarchyPath(lane) else { return false }
+            return seenPaths.insert(path).inserted
+        }
+        return merged + missing
+    }
+
+    // A project lane may be contained inside another registered work folder.
+    // Derive hierarchy from exact path segments, preserving Hermes lane/session IDs.
+    private func hierarchyPath(_ lane: ProjectSessionLane) -> String? {
+        guard let raw = lane.path?.trimmingCharacters(in: .whitespacesAndNewlines),
+              !raw.isEmpty else { return nil }
+        let segments = raw.split(separator: "/").map(String.init)
+        guard !segments.isEmpty else { return nil }
+        return (raw.hasPrefix("/") ? "/" : "") + segments.joined(separator: "/")
+    }
+
+    private func parentLaneID(for lane: ProjectSessionLane) -> String? {
+        guard let childPath = hierarchyPath(lane) else { return nil }
+        return lanes.compactMap { candidate -> (id: String, length: Int)? in
+            guard candidate.id != lane.id,
+                  let parentPath = hierarchyPath(candidate),
+                  childPath.hasPrefix(parentPath + "/") else { return nil }
+            return (candidate.id, parentPath.count)
+        }.max(by: { $0.length < $1.length })?.id
+    }
+
+    private var rootLanes: [ProjectSessionLane] {
+        lanes.filter { parentLaneID(for: $0) == nil }
+    }
+
+    private func childLanes(of parent: ProjectSessionLane) -> [ProjectSessionLane] {
+        lanes.filter { parentLaneID(for: $0) == parent.id }
+    }
+
+    private func visibleSessionCount(for lane: ProjectSessionLane) -> Int {
+        lane.sessions.count + childLanes(of: lane).reduce(0) {
+            $0 + visibleSessionCount(for: $1)
+        }
     }
 
